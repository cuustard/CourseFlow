rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Total multi-tenant isolation: a signed-in user may only read and write
    // documents nested anywhere beneath their own users/{userId} document.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
